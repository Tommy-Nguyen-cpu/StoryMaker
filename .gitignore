# This .gitignore file should be placed at the root of your Unity project directory
#
# Get latest from https://github.com/github/gitignore/blob/main/Unity.gitignore
#
.utmp/
UI/StoryUI/[Ll]ibrary/
UI/StoryUI/[Tt]emp/
UI/StoryUI/[Oo]bj/
UI/StoryUI/[Bb]uild/
UI/StoryUI/[Bb]uilds/
UI/StoryUI/[Ll]ogs/
UI/StoryUI/[Uu]ser[Ss]ettings/
UI/StoryUI/*.log

# By default unity supports Blender asset imports, *.blend1 blender files do not need to be commited to version control.
UI/StoryUI/*.blend1
UI/StoryUI/*.blend1.meta

# MemoryCaptures can get excessive in size.
# They also could contain extremely sensitive data
UI/StoryUI/[Mm]emoryCaptures/

# Recordings can get excessive in size
UI/StoryUI/[Rr]ecordings/

# Uncomment this line if you wish to ignore the asset store tools plugin
# /[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
UI/StoryUI/[Aa]ssets/Plugins/Editor/JetBrains*
# Jetbrains Rider personal-layer settings
UI/StoryUI/*.DotSettings.user

# Visual Studio cache directory
UI/StoryUI/.vs/

# Gradle cache directory
UI/StoryUI/.gradle/

# Autogenerated VS/MD/Consulo solution and project files
UI/StoryUI/ExportedObj/
UI/StoryUI/.consulo/
UI/StoryUI/*.csproj
UI/StoryUI/*.unityproj
UI/StoryUI/*.sln
UI/StoryUI/*.suo
UI/StoryUI/*.tmp
UI/StoryUI/*.user
UI/StoryUI/*.userprefs
UI/StoryUI/*.pidb
UI/StoryUI/*.booproj
UI/StoryUI/*.svd
UI/StoryUI/*.pdb
UI/StoryUI/*.mdb
UI/StoryUI/*.opendb
UI/StoryUI/*.VC.db

# Unity3D generated meta files
UI/StoryUI/*.pidb.meta
UI/StoryUI/*.pdb.meta
UI/StoryUI/*.mdb.meta

# Unity3D generated file on crash reports
UI/StoryUI/sysinfo.txt

# Mono auto generated files
UI/StoryUI/mono_crash.*

# Builds
UI/StoryUI/*.apk
UI/StoryUI/*.aab
UI/StoryUI/*.unitypackage
UI/StoryUI/*.unitypackage.meta
UI/StoryUI/*.app

# Crashlytics generated file
UI/StoryUI/crashlytics-build.properties

# TestRunner generated files
UI/StoryUI/InitTestScene*.unity*

# Addressables default ignores, before user customizations
UI/StoryUI/ServerData
UI/StoryUI/[Aa]ssets/StreamingAssets/aa*
UI/StoryUI/[Aa]ssets/AddressableAssetsData/link.xml*
UI/StoryUI/[Aa]ssets/Addressables_Temp*
# By default, Addressables content builds will generate addressables_content_state.bin
# files in platform-specific subfolders, for example:
# /Assets/AddressableAssetsData/OSX/addressables_content_state.bin
UI/StoryUI/[Aa]ssets/AddressableAssetsData/*/*.bin*

# Visual Scripting auto-generated files
UI/StoryUI/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db
UI/StoryUI/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db.meta
UI/StoryUI/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers
UI/StoryUI/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers.meta

# Auto-generated scenes by play mode tests
UI/StoryUI/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*
